Options -Indexes

RewriteEngine On

# Cache long pour les fichiers statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/gif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"

  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 6 months"
</IfModule>

# Normaliser : supprimer les doubles / ou le / final (sauf pour la racine)
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+?)/+$ /$1 [R=301,L]

# Si un fichier existe déjà, on ne touche à rien
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Si /page ou /page/ n'existe pas, mais /page.html existe, on le sert
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Utiliser la 404 générée par Next
ErrorDocument 404 /404.html

